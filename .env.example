# ── Server / AP
PORT=3001
NODE_ENV=development

# CORS origin — the frontend dev server URL
CLIENT_ORIGIN=http://localhost:5173

# Production frontend URL (used for CORS in production)
FRONTEND_URL=https://dimetime.netlify.app

# ── Database ─────────────────────────────────────────────────
# MongoDB URI template; replace with your own local or cloud connection string
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-url>/<db-name>?retryWrites=true&w=majority
# Alternative variable name also supported by server/config/db.js
# MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-url>/<db-name>

# ── Auth ─────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<generate-a-long-random-secret>
JWT_EXPIRES_IN=7d

# ── AI (Groq) ────────────────────────────────────────────────
# Obtain a key at https://console.groq.com
GROQ_API_KEY=<your-groq-api-key>
